      "B",
      128
     ]
    },
    "outputs": {
     "action": [
      "B",
      5
     ]
    },
    "normalisation": "none: the actor reads the raw observation concatenated with z"
   },
   "deterministic": true,
   "action": "mode of the tanh-squashed Gaussian, tanh(mean), clipped to [-1, 1] (the evaluator's own clip); log std is a constant 0, so the mode is the policy's action",
   "H_exec": 1,
   "replan": "every environment step (single-step actor)",
   "inference": {
    "B": "baselines/osfb_B.bin",
    "M": 10000,
    "dim": 128,
    "B_def": "backward representation B(s', a') of the arrival state and its departing action, clipped to +-(1 - 1e-5)",
    "samples": "the fixed 10k reference of the paper's readouts: transitions drawn uniformly with replacement over the 1000 training episodes with numpy default_rng(3917); one-step FB and TD-JEPA use the same 10k transitions",
    "label_points": {
     "file": "baselines/infer_cube_xyz.bin",
     "dim": 3,
     "what": "cube position (qpos[14:17]) of the arrival state s' of each inference transition"
    },
    "label_rule": {
     "kind": "ball",
     "radius": 0.04,
     "inclusive": false,
     "hit": 1,
     "miss": 0,
     "goal_fill": [
      null,
      null,
      0.02
     ],
     "note": "OGBench relabelling of the offline data at s': ||cube - goal|| < 0.04 (strict, 3-D; reward -1/0, shifted by +1), the same rule as ABI's cube labels; reproduces the cached labels of all 5 tasks exactly; a clicked (x, y) target takes z = 0.02 (table height, goal_fill)"
    },
    "z_rule": {
     "kind": "softmax_reward_mean",
     "temperature": 300.0,
     "weighting": "w = softmax(T r) over the M samples (author infer_latent)",
     "shift": "+1 on the OGBench reward (labels 0/1)",
     "normalisation": "z = sqrt(d) m / ||m|| (normalize_latent)",
     "sample_count": 10000,
     "formula": "m = mean_k (w_k r_k B_k); with 0/1 labels z is sqrt(d) times the normalised sum of B over the positive samples",
     "no_positive": "undefined in the original (0 / 0); here z = 0 and valid = false"
    }
   },
   "model": {
    "code": "one-step FB authors' agent code, unmodified",
    "training_seed": 3917,
    "updates": 1000000,
    "training_note": "the first run of this seed stopped before 1M updates on a logging-only overflow; it was continued from its last checkpoint to 1M with the unmodified update, optimiser and data order",
    "config": {
     "latent_dim": 128,
     "alpha": 0.3,
     "orthonorm_coeff": 0.3,
     "reward_temperature": 300.0,
     "discount": 0.99,
     "q_agg": "min",
     "actor_hidden_dims": [
      512,
      512,
      512,
      512
     ],
     "activation": "gelu",
     "tanh_squash": true,
     "const_std": true
    }
   },
