  "row": "m_psi (rule S DMC row): production critic, ExORL ridge readout on the frozen EMA psi",
  "score": "Q = mass * mean_heads F(window16, chunk8 at query 256) . z,  z = M w",
  "readout": "ridge_z: z = (G + lam I)^-1 Psi^T w / n,  G = Psi^T Psi / n,  lam = 1e-4 * max eig(G) (float64)",
  "M": "baked into abi_score/abi_grad as a float32 [d, R] matrix; minimum-norm rank-T correction so that M w_task reproduces the paper's cached z of every paper task (see the report)",
  "mass": 49.99999999999996,
  "gamma": 0.98,
  "d": 256,
  "R": 10000,
  "lam": 0.02536862108601187,
  "H_score": 8,
  "query": 256,
  "heads": "mean of the phi predictor heads",
  "note": "only argmax and gradient of Q are used"
 },
 "reference": {
  "rule": "10k arrival states s' = obs[t+1] of the critic's readout reference (paper.Inference(episodes, training seed)), in the critic's order",
  "labels": "per-task dm_control reward of the arrival state (relabel: set_state + set_control in a reset context, mj_forward, mj_fwdPosition, mj_sensorVel, mj_subtreeVel), float32",
