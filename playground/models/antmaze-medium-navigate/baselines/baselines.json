{
 "env": "antmaze-medium-navigate",
 "dataset": "antmaze-medium-navigate-v0",
 "training_seed": 3917,
 "default": "tdjepa",
 "paths": "file paths are relative to models/<env>/, as for the critic files",
 "policies": [
  {
   "id": "tdjepa",
   "label": "TD-JEPA actor",
   "short": "TD-JEPA actor",
   "note": "The trained actor of TD-JEPA, a zero-shot RL method. It infers the task from the goal by itself.",
   "onnx": "baselines/tdjepa_actor.onnx",
   "sd": 29,
   "ad": 8,
   "z_dim": 50,
   "io": {
    "inputs": {
     "obs": [
      "B",
      29
     ],
     "z": [
      "B",
      50
     ],
     "noise": [
      "B",
      8
     ]
    },
    "outputs": {
     "action": [
      "B",
      8
     ]
    },
    "normalisation": "none needed: the observation normaliser and pixel encoder of this model are identities; the graph takes the raw observation"
   },
   "deterministic": false,
   "noise": {
    "input": "noise",
    "dist": "N(0, I) of size ad",
    "per_call": "one fresh draw per act() call, i.e. per environment step",
    "default_seed": 1,
    "official": "model.act(obs, z, mean=True) ignores mean and draws torch.randn((1, ad)) inside the noise-conditioned actor at every call; the paper's evaluator seeds the global torch generator with reset + 17001 once per episode"
   },
   "action": "tanh output in (-1, 1); the official loop applies no further clipping (the environment clips to its control range)",
   "H_exec": 1,
   "replan": "every environment step (single-step actor)",
   "inference": {
    "B": "baselines/tdjepa_B.bin",
    "M": 10000,
    "dim": 50,
    "B_def": "psi(s') of the arrival observation: TD-JEPA's reward-inference features, normalised to ||psi|| = sqrt(d)",
    "samples": "the fixed 10k reference of the paper's readouts: transitions drawn uniformly with replacement over the 1000 training episodes with numpy default_rng(3917); one-step FB and TD-JEPA use the same 10k transitions",
    "label_points": {
     "file": "baselines/infer_xy.bin",
     "dim": 2,
     "what": "torso xy (qpos[0:2]) of the arrival state s' of each inference transition"
    },
    "label_rule": {
     "kind": "ball",
     "radius": 0.5,
     "inclusive": true,
     "hit": 1,
     "miss": 0,
     "note": "success test at s': ||xy - goal|| <= 0.5 (OGBench reward -1/0, shifted by +1); identical to ABI's rule; reproduces the cached labels of all 5 tasks exactly"
    },
    "z_rule": {
     "kind": "lstsq_project",
     "weighting": "none: ordinary least squares, ridge 0",
     "shift": "+1 on the OGBench reward (labels 0/1)",
     "normalisation": "z = sqrt(d) x / max(||x||, 1e-12) (project_z)",
     "sample_count": 10000,
     "formula": "x = argmin_x ||Psi x - r||_2 (torch.linalg.lstsq of the released reward_inference); browser: Cholesky solve of the normal equations in float64",
     "no_positive": "z = 0 (as project_z of a zero vector); reported as valid = false"
    }
   },
   "model": {
    "code": "TD-JEPA released code, unmodified",
    "training_seed": 3917,
    "updates": 1000000,
    "config": {
     "lr_psi": 0.0001,
     "lambda_psi": 0.1,
     "grid_index": 0,
     "selection": "released per-domain grid, selected by the final in-training success mean (prespecified rule, first in launcher order on ties)"
    },
    "actor_std": 0.2
   },
   "official_seed3917": [
    {
     "label": "reproduced TD-JEPA actor alone (T-a)",
     "protocol": "actor every step (H_exec 1), z from the 10k reference, test resets 40000-40019, 20 episodes per task",
